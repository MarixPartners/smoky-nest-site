# Normalize line endings so diffs are identical on Windows and Linux.
# Text files are stored with LF in the repository and checked out with LF.
* text=auto eol=lf

# Binary assets — never subject to line-ending conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4  binary
*.zip  binary
